{
  "id": "/",
  "name": "Canvas",
  "short_name": "Canvas",
  "description": "A browser-local workspace for notes, code, whiteboards, comparisons and JSON.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f8f5",
  "theme_color": "#f7f8f5",
  "icons": [
    { "src": "/icons/canvas-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/canvas-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "related_applications": [{ "platform": "webapp", "url": "/manifest.webmanifest", "id": "https://canvas.myth.am/" }],
  "prefer_related_applications": false
}
